#!/bin/sh /etc/rc.common
# sing-box service: pull verified binary to /tmp (RAM) at boot.

USE_PROCD=1
START=99
STOP=10

SB_DIR=/tmp/sing-box
SB_BIN=/tmp/sing-box/sing-box
SB_CONF=/etc/sing-box/config.json
SB_LOG=/var/log/sing-box.log
SB_VERSION="1.13.15"
SB_SHA256="c3ee43b877ca73359bc1ebdd8ad3d068b2efdafeedba0c3aba84f453d49bfbc4"
SB_REPO="wcwq99/PSG1218-OpenWrt"
SB_BASE_URL="https://github.com/${SB_REPO}/releases/download/sing-box-mipsle-${SB_VERSION}/sing-box-mipsle"
SB_PROXIES="https://proxy.wxgwxha.eu.org/ https://ghfast.top/ https://gh-proxy.com/ "

boot() {
    start
}

verify_sb() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    printf '%s  %s\n' "$SB_SHA256" "$1" | sha256sum -c - >/dev/null 2>&1
}

download_sb() {
    umask 077
    mkdir -p "$SB_DIR" || return 1
    chmod 0700 "$SB_DIR" || return 1

    if verify_sb "$SB_BIN"; then
        chmod 0700 "$SB_BIN"
        echo "sing-box 已存在且校验通过,跳过下载"
        return 0
    fi
    rm -f "$SB_BIN"

    tmp=$(mktemp "$SB_DIR/.download.XXXXXX") || return 1
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    echo "正在下载 sing-box 到 /tmp ..."

    for proxy in $SB_PROXIES; do
        url="${proxy}${SB_BASE_URL}"
        echo "  尝试: $url"
        if wget -q -T 30 -O "$tmp" "$url" 2>/dev/null && verify_sb "$tmp"; then
            chmod 0700 "$tmp" && mv -f "$tmp" "$SB_BIN"
            trap - EXIT HUP INT TERM
            echo "sing-box 下载并校验成功,经由 ${proxy}"
            return 0
        fi
        : > "$tmp"
    done

    echo "  尝试直连: $SB_BASE_URL"
    if wget -q -T 30 -O "$tmp" "$SB_BASE_URL" 2>/dev/null && verify_sb "$tmp"; then
        chmod 0700 "$tmp" && mv -f "$tmp" "$SB_BIN"
        trap - EXIT HUP INT TERM
        echo "sing-box 下载并校验成功,经由直连"
        return 0
    fi

    rm -f "$tmp"
    trap - EXIT HUP INT TERM
    echo "所有下载源均失败或 SHA-256 校验不通过。" >&2
    return 1
}

start_service() {
    [ -f "$SB_CONF" ] || { echo "配置文件不存在: $SB_CONF"; return 1; }
    download_sb || return 1

    mkdir -p /var/log
    touch "$SB_LOG" 2>/dev/null

    procd_open_instance
    procd_set_param command "$SB_BIN" run -c "$SB_CONF"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 300 5 10
    procd_close_instance
    echo "sing-box 已启动,配置: $SB_CONF"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_interface_trigger "interface.*" "wan" /etc/init.d/sing-box reload
}
