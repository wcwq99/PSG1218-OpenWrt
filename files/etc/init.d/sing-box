#!/bin/sh /etc/rc.common
# sing-box service: pull trimmed+upx binary to /tmp (RAM) at boot, run from memory.
# Binary built by .github/workflows/build-singbox.yml, published to repo Release.
# Flash too small for Go binary; /tmp (32MB) holds the ~3-5MB compressed binary fine.

USE_PROCD=1
START=99
STOP=10

SB_DIR=/tmp/sing-box
SB_BIN=/tmp/sing-box/sing-box
SB_CONF=/etc/sing-box/config.json
SB_LOG=/var/log/sing-box.log
SB_VERSION="1.13.15"
# Repo owner/name - update if you rename the fork
SB_REPO="wcwq99/PSG1218-OpenWrt"
SB_BASE_URL="https://github.com/${SB_REPO}/releases/download/sing-box-mipsle-${SB_VERSION}/sing-box-mipsle"
# GitHub download proxies in priority order; trailing empty string = direct fallback
SB_PROXIES="https://proxy.wxgwxha.eu.org/ https://ghfast.top/ https://gh-proxy.com/ "

boot() {
    start
}

download_sb() {
    mkdir -p "$SB_DIR"
    if [ -x "$SB_BIN" ]; then
        echo "sing-box 已存在于 /tmp,跳过下载"
        return 0
    fi

    echo "正在下载 sing-box 到 /tmp ..."
    # 依次尝试代理前缀(代理 + 完整 GitHub URL),全部失败后回退直连
    for proxy in $SB_PROXIES; do
        url="${proxy}${SB_BASE_URL}"
        echo "  尝试: $url"
        if wget -q -T 30 -O "$SB_BIN" "$url" 2>/dev/null && [ -s "$SB_BIN" ]; then
            chmod +x "$SB_BIN"
            echo "sing-box 下载成功: $SB_BIN ($(wc -c < "$SB_BIN") 字节),经由 ${proxy}"
            return 0
        fi
        rm -f "$SB_BIN"
    done

    # 直连回退(无代理)
    echo "  尝试直连: $SB_BASE_URL"
    if wget -q -T 30 -O "$SB_BIN" "$SB_BASE_URL" 2>/dev/null && [ -s "$SB_BIN" ]; then
        chmod +x "$SB_BIN"
        echo "sing-box 下载成功: $SB_BIN ($(wc -c < "$SB_BIN") 字节),经由直连"
        return 0
    fi
    rm -f "$SB_BIN"

    echo "所有下载源均失败。"
    echo "请检查代理可用性,或先运行 build-singbox.yml 工作流发布二进制。"
    return 1
}

start_service() {
    [ -f "$SB_CONF" ] || { echo "配置文件不存在: $SB_CONF"; return 1; }

    download_sb || return 1

    # 预创建日志文件,确保 LuCI 和 logrotate 可读写
    mkdir -p /var/log
    touch "$SB_LOG" 2>/dev/null

    procd_open_instance
    procd_set_param command "$SB_BIN" run -c "$SB_CONF"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 300 5 10
    procd_close_instance
    echo "sing-box 已启动,配置: $SB_CONF"
}

reload_service() {
    stop
    start
}

service_triggers() {
    # WAN 起来后触发 reload,解决开机时网络未就绪导致下载失败
    # procd_add_interface_trigger <object-filter> <interface> <script> <action>
    # object-filter 必须是 "interface.*"(匹配 ubus network.interface.* 对象),
    # 不能带 .up 后缀(那不是合法 ubus object,trigger 永不触发)
    procd_add_interface_trigger "interface.*" "wan" /etc/init.d/sing-box reload
}
