#!/bin/sh /etc/rc.common
# sing-box service: pull trimmed+upx binary to /tmp (RAM) at boot, run from memory.
# Binary built by .github/workflows/build-singbox.yml, published to repo Release.
# Flash too small for Go binary; /tmp (32MB) holds the ~3-5MB compressed binary fine.

USE_PROCD=1
START=99
STOP=10

SB_DIR=/tmp/sing-box
SB_BIN=/tmp/sing-box/sing-box
SB_CONF=/etc/sing-box/config.json
SB_VERSION="1.13.15"
# Repo owner/name - update if you rename the fork
SB_REPO="wcwq99/PSG1218-OpenWrt"
SB_BASE_URL="https://github.com/${SB_REPO}/releases/download/sing-box-mipsle-${SB_VERSION}/sing-box-mipsle"
# GitHub download proxies in priority order; trailing empty string = direct fallback
SB_PROXIES="https://proxy.wxgwxha.eu.org/ https://ghfast.top/ https://gh-proxy.com/ "

boot() {
    start
}

download_sb() {
    mkdir -p "$SB_DIR"
    if [ -x "$SB_BIN" ]; then
        echo "sing-box already in /tmp, skip download"
        return 0
    fi

    echo "Downloading sing-box to /tmp ..."
    # Try each proxy prefix (proxy + full GitHub URL), then direct URL as fallback
    for proxy in $SB_PROXIES; do
        url="${proxy}${SB_BASE_URL}"
        echo "  try: $url"
        if wget-ssl -q -T 30 -O "$SB_BIN" "$url" 2>/dev/null && [ -s "$SB_BIN" ]; then
            chmod +x "$SB_BIN"
            echo "sing-box ready at $SB_BIN ($(wc -c < "$SB_BIN") bytes) via ${proxy}"
            return 0
        fi
        rm -f "$SB_BIN"
    done

    # Direct fallback (no proxy)
    echo "  try direct: $SB_BASE_URL"
    if wget-ssl -q -T 30 -O "$SB_BIN" "$SB_BASE_URL" 2>/dev/null && [ -s "$SB_BIN" ]; then
        chmod +x "$SB_BIN"
        echo "sing-box ready at $SB_BIN ($(wc -c < "$SB_BIN") bytes) via direct"
        return 0
    fi
    rm -f "$SB_BIN"

    echo "Download failed from all sources."
    echo "Check proxy availability or run build-singbox.yml to publish the binary."
    return 1
}

start_service() {
    [ -f "$SB_CONF" ] || { echo "Config not found: $SB_CONF"; return 1; }

    download_sb || return 1

    procd_open_instance
    procd_set_param command "$SB_BIN" run -c "$SB_CONF"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 300 5 10
    procd_close_instance
    echo "sing-box started, config: $SB_CONF"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_config_trigger "config.change" "sing-box" /etc/init.d/sing-box reload
}
