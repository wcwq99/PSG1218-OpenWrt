{
	"luci-app-singbox": {
		"description": "Grant access to sing-box server management",
		"read": {
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/init.d/sing-box": [ "exec" ],
				"/etc/sing-box/config.json": [ "read" ],
				"/tmp/sing-box/sing-box": [ "exec" ],
				"/sbin/logread": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/etc/sing-box/config.json": [ "write" ]
			}
		}
	}
}
